{
  "schema_version": 1,
  "plugin_id": "subscriptions-ai",
  "summary": "Optional model-based subscription classification through declared public APIs.",
  "delegates": [],
  "operations": [
    {
      "name": "configure",
      "kind": "local",
      "summary": "Local subscription configure action. AI actions require an explicitly enabled companion and data permission.",
      "input": {
        "type": "object",
        "description": "Operation parameters.",
        "properties": {
          "workspace": {
            "type": "string",
            "description": "Addressed workspace.",
            "enum": [
              "personal",
              "demo"
            ]
          },
          "month": {
            "type": "string",
            "description": "Calendar month YYYY-MM, between 1900-01 and 2200-12.",
            "pattern": "^(19|20|21)\\d{2}-(0[1-9]|1[0-2])$|^2200-(0[1-9]|1[0-2])$"
          },
          "currency": {
            "type": "string",
            "description": "ISO currency code; no currency conversion is performed.",
            "pattern": "^[A-Z]{3}$"
          },
          "action": {
            "type": "string",
            "description": "Local subscription settings action.",
            "const": "configure"
          },
          "config": {
            "type": "object",
            "description": "Explicit selected provider/model settings and transaction-data consent. Credentials remain in AI credentials.",
            "properties": {
              "provider": {
                "type": "string",
                "description": "Provider connection.",
                "enum": [
                  "chatgpt",
                  "openai",
                  "anthropic",
                  "openrouter"
                ]
              },
              "connectionId": {
                "type": "string",
                "description": "Opaque saved connection UUID, not a credential."
              },
              "model": {
                "type": "string",
                "description": "Exact text model ID.",
                "minLength": 1,
                "maxLength": 200
              },
              "effort": {
                "type": "string",
                "description": "Provider-supported effort, or default."
              },
              "consent": {
                "type": "boolean",
                "description": "Explicit permission to send the documented transaction data.",
                "const": true
              }
            },
            "required": [
              "provider",
              "connectionId",
              "model",
              "effort",
              "consent"
            ],
            "additionalProperties": false
          },
          "transactionId": {
            "type": "string",
            "description": "Stable identifier returned by a read; never a display name.",
            "minLength": 1,
            "maxLength": 200
          },
          "fingerprint": {
            "type": "string",
            "description": "Current payment fingerprint."
          },
          "decision": {
            "type": "object",
            "description": "Legacy manual label: isSubscription, cadence and score. Public set_label needs no score."
          },
          "operationId": {
            "type": "string",
            "description": "UUID for an explicitly started background scan."
          },
          "jobId": {
            "type": "string",
            "description": "Observed job UUID used to stop that exact scan."
          },
          "mode": {
            "type": "string",
            "description": "Manual uses no model.",
            "enum": [
              "manual",
              "ai"
            ],
            "default": "manual"
          }
        },
        "required": [
          "workspace",
          "month",
          "currency",
          "action",
          "config"
        ],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "description": "Local subscription report, configuration references, classification mode and job status; no credential values.",
        "properties": {
          "transactions": {
            "type": "array",
            "description": "Payments with id/date/merchant/amount/account/category/status/cadence/source/fingerprint.",
            "items": {
              "type": "object",
              "description": "Public payment classification and observed fingerprint.",
              "properties": {
                "id": {
                  "type": "string",
                  "description": "Stable transaction ID."
                },
                "date": {
                  "type": "string",
                  "description": "Calendar date YYYY-MM-DD."
                },
                "merchant": {
                  "type": "string",
                  "description": "Payee display name."
                },
                "amount": {
                  "type": "integer",
                  "description": "Expense in selected-currency minor units."
                },
                "category": {
                  "type": "string",
                  "description": "Category display path or Uncategorized."
                },
                "account": {
                  "type": "string",
                  "description": "Account display name; identity is carried by transaction ID."
                },
                "status": {
                  "type": "string",
                  "description": "Classification state.",
                  "enum": [
                    "excluded",
                    "unclassified",
                    "needs-review",
                    "subscription",
                    "not-subscription"
                  ]
                },
                "cadence": {
                  "type": "string",
                  "description": "Observed billing interval.",
                  "enum": [
                    "monthly",
                    "annual",
                    "quarterly",
                    "weekly",
                    "unknown"
                  ]
                },
                "source": {
                  "type": "string",
                  "description": "Classification origin; empty when unclassified.",
                  "enum": [
                    "",
                    "rules",
                    "manual",
                    "ai",
                    "cache"
                  ]
                },
                "fingerprint": {
                  "type": "string",
                  "description": "Current payment fingerprint required for a manual label."
                }
              },
              "required": [
                "id",
                "date",
                "merchant",
                "amount",
                "category",
                "account",
                "status",
                "cadence",
                "source",
                "fingerprint"
              ]
            }
          },
          "subscriptions": {
            "type": "array",
            "description": "Plans with latest charge/frequency, monthly and annual equivalents, occurrence counts and active status.",
            "items": {
              "type": "object",
              "description": "Subscription plan with latest same-date charges combined.",
              "properties": {
                "id": {
                  "type": "string",
                  "description": "Stable transaction ID."
                },
                "date": {
                  "type": "string",
                  "description": "Calendar date YYYY-MM-DD."
                },
                "merchant": {
                  "type": "string",
                  "description": "Payee display name."
                },
                "amount": {
                  "type": "integer",
                  "description": "Expense in selected-currency minor units."
                },
                "category": {
                  "type": "string",
                  "description": "Category display path or Uncategorized."
                },
                "account": {
                  "type": "string",
                  "description": "Account display name; identity is carried by transaction ID."
                },
                "status": {
                  "type": "string",
                  "description": "Classification state.",
                  "enum": [
                    "excluded",
                    "unclassified",
                    "needs-review",
                    "subscription",
                    "not-subscription"
                  ]
                },
                "cadence": {
                  "type": "string",
                  "description": "Observed billing interval.",
                  "enum": [
                    "monthly",
                    "annual",
                    "quarterly",
                    "weekly",
                    "unknown"
                  ]
                },
                "source": {
                  "type": "string",
                  "description": "Classification origin; empty when unclassified.",
                  "enum": [
                    "",
                    "rules",
                    "manual",
                    "ai",
                    "cache"
                  ]
                },
                "fingerprint": {
                  "type": "string",
                  "description": "Current payment fingerprint required for a manual label."
                },
                "monthly": {
                  "type": "integer",
                  "description": "Rounded monthly equivalent in minor units; zero for unknown cadence."
                },
                "annual": {
                  "type": "integer",
                  "description": "Annual equivalent computed directly from charges."
                },
                "active": {
                  "type": "boolean",
                  "description": "Latest charge falls within the cadence-specific recency window."
                },
                "occurrences": {
                  "type": "integer",
                  "description": "All observed charge count."
                },
                "occurrencesLast12Months": {
                  "type": "integer",
                  "description": "Charge count after the rolling cutoff."
                },
                "charges": {
                  "type": "array",
                  "description": "Underlying individually classified payments.",
                  "items": {
                    "type": "object",
                    "description": "Public payment classification and observed fingerprint.",
                    "properties": {
                      "id": {
                        "type": "string",
                        "description": "Stable transaction ID."
                      },
                      "date": {
                        "type": "string",
                        "description": "Calendar date YYYY-MM-DD."
                      },
                      "merchant": {
                        "type": "string",
                        "description": "Payee display name."
                      },
                      "amount": {
                        "type": "integer",
                        "description": "Expense in selected-currency minor units."
                      },
                      "category": {
                        "type": "string",
                        "description": "Category display path or Uncategorized."
                      },
                      "account": {
                        "type": "string",
                        "description": "Account display name; identity is carried by transaction ID."
                      },
                      "status": {
                        "type": "string",
                        "description": "Classification state.",
                        "enum": [
                          "excluded",
                          "unclassified",
                          "needs-review",
                          "subscription",
                          "not-subscription"
                        ]
                      },
                      "cadence": {
                        "type": "string",
                        "description": "Observed billing interval.",
                        "enum": [
                          "monthly",
                          "annual",
                          "quarterly",
                          "weekly",
                          "unknown"
                        ]
                      },
                      "source": {
                        "type": "string",
                        "description": "Classification origin; empty when unclassified.",
                        "enum": [
                          "",
                          "rules",
                          "manual",
                          "ai",
                          "cache"
                        ]
                      },
                      "fingerprint": {
                        "type": "string",
                        "description": "Current payment fingerprint required for a manual label."
                      }
                    },
                    "required": [
                      "id",
                      "date",
                      "merchant",
                      "amount",
                      "category",
                      "account",
                      "status",
                      "cadence",
                      "source",
                      "fingerprint"
                    ]
                  }
                }
              },
              "required": [
                "id",
                "date",
                "merchant",
                "amount",
                "category",
                "account",
                "status",
                "cadence",
                "source",
                "fingerprint",
                "monthly",
                "annual",
                "active",
                "occurrences",
                "occurrencesLast12Months",
                "charges"
              ]
            }
          },
          "estimatedMonthly": {
            "type": "integer",
            "description": "Estimated monthly minor units for recent known-cadence plans."
          },
          "estimatedAnnual": {
            "type": "integer",
            "description": "Annual equivalent computed directly from actual charge amounts."
          },
          "actualMonth": {
            "type": "integer",
            "description": "Actual classified charges in the selected month."
          },
          "unclassified": {
            "type": "integer",
            "description": "Eligible unchecked payment count."
          },
          "needsReview": {
            "type": "integer",
            "description": "Uncertain classification count."
          },
          "months": {
            "type": "array",
            "description": "Actual monthly classified charges.",
            "items": {
              "type": "object",
              "description": "Actual monthly charges and change from the previous month.",
              "properties": {
                "month": {
                  "type": "string",
                  "description": "Calendar month YYYY-MM."
                },
                "amount": {
                  "type": "integer",
                  "description": "Classified charges in minor units."
                },
                "change": {
                  "type": "integer",
                  "description": "Difference from the previous month in minor units."
                }
              },
              "required": [
                "month",
                "amount",
                "change"
              ]
            }
          },
          "byCategory": {
            "type": "array",
            "description": "Monthly cost grouped by category.",
            "items": {
              "type": "object",
              "description": "Monthly equivalent grouped by display name.",
              "properties": {
                "name": {
                  "type": "string",
                  "description": "Category path or payee display name."
                },
                "amount": {
                  "type": "integer",
                  "description": "Monthly equivalent in minor units."
                }
              },
              "required": [
                "name",
                "amount"
              ]
            }
          },
          "byMerchant": {
            "type": "array",
            "description": "Monthly cost grouped by payee.",
            "items": {
              "type": "object",
              "description": "Monthly equivalent grouped by display name.",
              "properties": {
                "name": {
                  "type": "string",
                  "description": "Category path or payee display name."
                },
                "amount": {
                  "type": "integer",
                  "description": "Monthly equivalent in minor units."
                }
              },
              "required": [
                "name",
                "amount"
              ]
            }
          },
          "asOfDate": {
            "type": "string",
            "description": "Earlier of today and the selected month end."
          },
          "chargesSince": {
            "type": "string",
            "description": "Inclusive lower bound for the rolling twelve-month count."
          },
          "config": {
            "type": "object",
            "description": "Provider/model/effort/connection reference and explicit consent; no API key or token."
          },
          "classificationMode": {
            "type": "string",
            "description": "Selected classification mode.",
            "enum": [
              "manual",
              "ai"
            ]
          },
          "aiAvailable": {
            "type": "boolean",
            "description": "Whether the optional classifier companion is enabled."
          },
          "job": {
            "type": "object",
            "description": "Current background scan status; idle when the companion is disabled."
          }
        },
        "required": [
          "transactions",
          "subscriptions",
          "estimatedMonthly",
          "estimatedAnnual",
          "actualMonth",
          "unclassified",
          "needsReview",
          "months",
          "byCategory",
          "byMerchant",
          "asOfDate",
          "chargesSince"
        ]
      },
      "examples": [
        {
          "input": {
            "workspace": "demo",
            "month": "2026-11",
            "currency": "USD",
            "action": "configure",
            "config": {
              "provider": "openai",
              "connectionId": "00000000-0000-0000-0000-000000000000",
              "model": "fictional-model",
              "effort": "default",
              "consent": true
            }
          },
          "output": {
            "transactions": [],
            "subscriptions": [],
            "estimatedMonthly": 0,
            "estimatedAnnual": 0,
            "actualMonth": 0,
            "unclassified": 0,
            "needsReview": 0,
            "months": [],
            "byCategory": [],
            "byMerchant": [],
            "asOfDate": "2026-11-01",
            "chargesSince": "2025-11-02",
            "config": {},
            "classificationMode": "manual",
            "aiAvailable": false,
            "job": {
              "status": "idle"
            }
          }
        }
      ],
      "side_effects": "Validate and save explicitly consented classifier configuration; selects AI mode. Requires the companion.",
      "permissions": "Local authority access with HTTPS and Host/origin checks. Not exposed by the remote ledger API.",
      "scope": "Explicit budget and personal/demo workspace; currencies are never combined.",
      "errors": [
        "Invalid or unsupported input is rejected without applying a new decision.",
        "Unavailable feature/storage returns an authored error; stale revisions and reused request IDs with different intent conflict."
      ],
      "retry": "Inspect local state after an uncertain mutation. Paid inference is never automatically retried.",
      "availability": "POST /api/plugin-settings/subscriptions (AI actions supplied by subscriptions-ai)"
    },
