# Add your keys locally. Never put them in frontend code or commit this file's copy.
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
# scripts/setup.py generates this locally; preserve it after linking accounts.
TOKEN_ENCRYPTION_KEY=
# Optional public HTTPS webhook URL. Local development can use manual sync.
PLAID_WEBHOOK_URL=
# Optional OAuth redirect; production redirects must be HTTPS and registered in Plaid.
PLAID_REDIRECT_URI=
# Set true only when ready to create real connections.
ALLOW_LIVE_PLAID=false
PORT=5173
# Opt-in entry-point names for trusted, separately installed Python plugins.
# Example: install plugins/example/example, then set WHAB_PLUGINS=plaid,example.
# Empty disables optional plugins, including Plaid. Unset defaults to plaid for upgrades.
WHAB_PLUGINS=plaid
# Exactly one storage plugin is required; it is loaded independently of WHAB_PLUGINS.
WHAB_STORAGE=sqlite
# The selected user interface. Empty runs only the JSON/CSV API.
WHAB_UI=web
